DISCORD_TOKEN=replace-with-your-bot-token

# Optional: set this to the Uncs & Co server ID so slash commands register instantly there.
DISCORD_GUILD_ID=

# Optional channel customization.
STATISTICS_CATEGORY_NAME=Statistics
RECORD_BOOK_CHANNEL_NAME=record-book

# Local durable store for screenshot-backed records.
DATA_DIR=./data

# Tesseract OCR settings.
OCR_LANGUAGE=eng
MAX_IMAGE_BYTES=12582912
RECORDS_PER_MODE=10
